---
import "../../styles/prose.css";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const publications = await getCollection("publications");
  return publications.map((pub) => ({ params: { id: pub.id }, props: { pub } }));
}

const { pub } = Astro.props;
const { Content } = await render(pub);
---

<Base title={pub.data.title} description={pub.data.summary}>
  <article class="wrap paper">
    <a class="back kicker" href="/publications">← All publications</a>
    <p class="kicker meta">
      <time datetime={pub.data.date.toISOString()}>
        {pub.data.date.toLocaleDateString("en-GB", { month: "long", year: "numeric" })}
      </time>
      · {pub.data.venue}
    </p>
    <h1>{pub.data.title}</h1>
    {pub.data.authors && <p class="authors">{pub.data.authors.join(", ")}</p>}
    <ul class="chips">{pub.data.tags.map((t) => <li class="chip">{t}</li>)}</ul>

    <h2 class="kicker abstract-label">Abstract</h2>
    <div class="prose">
      <Content />
    </div>

    {pub.data.link && (
      <a class="read" href={pub.data.link}>
        Read the paper <span>↗</span>
      </a>
    )}
  </article>
</Base>

<style>
  .paper {
    max-width: 52rem;
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  .back {
    text-decoration: none;
  }

  .meta {
    margin-top: 2.5rem;
  }

  h1 {
    margin: 1rem 0 1.5rem;
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
  }

  .authors {
    color: var(--ink-2);
  }

  .abstract-label {
    margin: 3rem 0 1rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .prose {
    font-size: 1.12rem;
  }

  .prose :global(p:first-child::first-letter) {
    float: left;
    margin: 0.08em 0.1em 0 0;
    font-family: var(--font-display);
    font-size: 3.6em;
    line-height: 0.8;
    color: var(--accent);
  }

  .read {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s, transform 0.3s var(--ease);
  }

  .read:hover {
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-2px);
  }
</style>
