---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Paper from "../../components/Paper.astro";
import { sortPapers } from "../../data/research";
import { site } from "../../data/site";

const papers = sortPapers(await getCollection("publications"));
const safety = papers.filter((p) => p.data.theme !== "other");
const other = papers.filter((p) => p.data.theme === "other");
const firstAuthor = papers.filter((p) => p.data.authors[0] === site.name).length;
const glyphs = ["γ", "λ", "ε", "π", "β", "α", "θ"];
---

<Base title="Research" description="Papers by Lucas Biéchy on AI safety: LLM calibration and honesty, human-AI alignment and privacy.">
  <header class="wrap page-head">
    <p class="kicker" data-reveal>Research · {papers.length} papers · {firstAuthor} first-author</p>
    <h1 class="page-title" data-reveal style="--delay: .08s">Papers &amp; <em>preprints</em></h1>
    <p class="lede" data-reveal style="--delay: .16s">
      Can we trust what LLMs tell us about their own confidence, how they grade their own work, or what they do
      with our personal data? That's what these papers are about.{" "}
      <a class="rss" href="/publications/rss.xml"><Icon name="rss" size={14} /> RSS</a>
    </p>
  </header>

  <section class="wrap">
    <h2 class="kicker group">AI safety</h2>
    {safety.map((paper, i) => <Paper paper={paper} glyph={glyphs[i % glyphs.length]} />)}
  </section>

  {other.length > 0 && (
    <section class="wrap earlier">
      <h2 class="kicker group">Earlier work</h2>
      {other.map((paper) => <Paper paper={paper} />)}
    </section>
  )}
</Base>

<style>
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .group {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-style: normal;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .earlier {
    margin-top: 4rem;
  }
</style>
