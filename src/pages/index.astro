---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Marquee from "../components/Marquee.astro";
import NewsTimeline from "../components/NewsTimeline.astro";
import { site } from "../data/site";
import { news } from "../data/news";
import { sortPapers, statusLabel, themes, type Theme } from "../data/research";
import { getKnowledge } from "../lib/knowledge";

const papers = sortPapers(await getCollection("publications"));
const { notes } = await getKnowledge();
const privacySkills = papers.find((p) => p.id.includes("privacyskills"));
const testingLearner = papers.find((p) => p.id.includes("testing-a-learner"));
const observation = papers.find((p) => p.id.includes("observation-to-intervention"));
const ringText = "Lucas Biéchy ✺ Lucas Biéchy ✺ Lucas Biéchy ✺ ";
const tones: Record<Theme, string> = { privacy: "var(--lime)", uncertainty: "var(--cobalt)", evals: "var(--accent)" };
---

<Base>
  <section class="hero">
    <div class="blob blob-a" aria-hidden="true"></div>
    <div class="blob blob-b" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <h1 class="hero-title">
        <span class="line" data-reveal style="--delay: .05s">Lucas</span>
        <span class="line indent" data-reveal style="--delay: .15s"><em>Biéchy</em><span class="sparkle">✺</span></span>
      </h1>

      <div class="badge" data-reveal style="--delay: .3s">
        <svg class="ring" viewBox="0 0 200 200" aria-hidden="true">
          <defs>
            <path id="ring-path" d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0" />
          </defs>
          <text><textPath href="#ring-path" textLength="512" lengthAdjust="spacing">{ringText}</textPath></text>
        </svg>
        <img src="/img/memojie/hey.png" alt="Lucas' memoji waving hello" width="420" height="420" />
      </div>

      <div class="hero-intro" data-reveal style="--delay: .35s">
        <p class="statement">
          I like research that goes <em>all the way</em>: from a theorem, to an experiment, to the people it ends up
          affecting.
        </p>
        <p class="creds">
          PhD researcher at <a href="https://www.inria.fr/">Inria</a> in the{" "}
          <a href="https://team.inria.fr/petscraft/">PETSCRAFT team</a>, fellow at{" "}
          <a href="https://caish.org/mars">MARS V</a> and <a href="https://bluedot.org/">BlueDot Impact</a> alumnus.
        </p>

        <div class="hero-ctas">
          <a class="btn btn-primary" href="/publications">Read my research <Icon name="arrow" size={16} /></a>
          <a class="btn" href={`mailto:${site.email}`}><Icon name="mail" size={16} /> Email me</a>
          <a class="btn btn-ghost" href={site.cv} target="_blank" rel="noopener">View my CV</a>
        </div>
      </div>
    </div>
  </section>

  <Marquee items={site.topics} />

  <section class="wrap papers-section">
    <div class="section-head split" data-reveal>
      <div>
        <p class="kicker">01 · At a glance</p>
        <h2 class="section-title">Research, execution, <em>track record</em></h2>
      </div>
      <a class="arrow-link" href="/publications">All {papers.length} papers <span>↗</span></a>
    </div>

    <div class="bento">
      {privacySkills && (
        <a class="tile tile-empirical" href={privacySkills.data.link ?? "/publications"} data-reveal>
          <span class="pill">Selected paper</span>
          <p class="kicker">Empirical · {statusLabel[privacySkills.data.status]}, {privacySkills.data.venue}</p>
          <h3>PrivacySkills</h3>
          <p class="big-number">30%</p>
          <p class="tile-text">
            of runs where LLM agents dig into confidential sources even though a harmless option exists. Privacy
            labels on the skills plus a system instruction roughly halve it.
          </p>
          <span class="tile-arrow"><Icon name="arrow" size={20} /></span>
          <img class="tile-memoji" src="/img/memojie/computer_.png" alt="" width="420" height="420" loading="lazy" />
        </a>
      )}

      {testingLearner && (
        <a class="tile tile-theory" href={testingLearner.data.link ?? "/publications"} data-reveal style="--delay: .08s">
          <span class="pill">Selected paper</span>
          <p class="kicker">Theory · {statusLabel[testingLearner.data.status]}, {testingLearner.data.venue}</p>
          <h3>Testing a Learner Changes It</h3>
          <p class="big-number">7×</p>
          <p class="tile-text">
            fewer rounds than random probes to catch a mildly biased self-grading agent (57 vs 424), with a lower
            bound showing no adaptive audit can do better.
          </p>
          <span class="tile-arrow"><Icon name="arrow" size={20} /></span>
          <img class="tile-memoji" src="/img/memojie/image00002.png" alt="" width="420" height="420" loading="lazy" />
        </a>
      )}

      <div class="tile tile-mars" data-reveal style="--delay: .12s">
        <div class="mars-big">
          <p class="kicker">MARS V · summer 2026</p>
          <p class="big-number">7 <em>weeks</em></p>
        </div>
        <div class="mars-text">
          <p>
            From the MARS V kick-off in mid-July to a paper accepted at the BiAlign Workshop @ NeurIPS:{" "}
            <a href={observation?.data.link ?? "/publications"}><em>From Observation to Intervention</em></a>, on
            identifying latent user bias in human-AI interaction.
          </p>
        </div>
        <img class="tile-memoji" src="/img/memojie/news.png" alt="" width="420" height="420" loading="lazy" />
      </div>

      <a class="tile tile-mini-row tile-hermes" href="/projects" data-reveal style="--delay: .16s">
        <span class="pill">Upcoming project</span>
        <p class="kicker">Theory → practice</p>
        <h3>Testing a Learner Changes It, applied to Hermes</h3>
        <p class="tile-small">Hermes learns from its own judgments of success, so it can fall into exactly the bias the paper detects.</p>
        <span class="tile-arrow"><Icon name="arrow" size={18} /></span>
        <img class="tile-memoji" src="/img/memojie/image00006.png" alt="" width="420" height="420" loading="lazy" />
      </a>

      <div class="tile tile-mini-row tile-now" data-reveal style="--delay: .18s">
        <p class="kicker">AI safety community</p>
        <h3>Programs, schools &amp; workshops</h3>
        <ul class="mini-list">
          <li><span><strong><a href="https://caish.org/mars">MARS V</a> fellow</strong> · Cambridge AI Safety Hub</span><time>2026</time></li>
          <li><span><strong>Technical AI Safety</strong> · <a href="https://bluedot.org/">BlueDot Impact</a></span><time>2026</time></li>
          <li><span><strong>BiAlign workshop</strong> · NeurIPS</span><time>2026</time></li>
          <li><span><strong>MLSS</strong> · Columbia University</span><time>2026</time></li>
          <li><span><strong>ELSA workshop</strong> · privacy-preserving ML</span><time>2025</time></li>
        </ul>
        <img class="tile-memoji corner" src="/img/memojie/computer.png" alt="" width="420" height="420" loading="lazy" />
      </div>

      <div class="tile tile-mini-row tile-hands" data-reveal style="--delay: .2s">
        <p class="kicker">Hands-on</p>
        <h3>I run my experiments end to end</h3>
        <ul class="mini-list">
          <li><span>Open-weight models and closed APIs</span></li>
          <li><span>Fine-tuning and RL</span></li>
          <li><span>Large eval runs with SLURM</span></li>
          <li><span>Agentic coding, to go from idea to first results fast</span></li>
        </ul>
        <p class="stack">Python · PyTorch · Hugging Face</p>
      </div>

      <div class="tile tile-mini-row tile-lead" data-reveal style="--delay: .22s">
        <span class="glyph" aria-hidden="true">✺</span>
        <p class="kicker">Mentoring &amp; teaching</p>
        <h3>Passing it on</h3>
        <ul class="mini-list">
          <li><span><strong>Mentored 2 research interns</strong> · one now co-author on PrivacySkills</span></li>
          <li><span><strong>TA in probability &amp; statistics</strong> · ENSTA Paris</span></li>
          <li><span><strong>Organised the team research seminar</strong> · PETSCRAFT</span></li>
        </ul>
      </div>

      <div class="tile tile-mini-row tile-talks" data-reveal style="--delay: .24s">
        <span class="glyph" aria-hidden="true">“</span>
        <p class="kicker">Talks &amp; outreach</p>
        <h3>On stage, for experts and for everyone</h3>
        <ul class="mini-list talk-list">
          <li><span><em class="tag">Technical</em><strong><a href="https://youtu.be/ZhORtZ00Ur0?t=2760">AI &amp; Cybersecurity</a></strong></span><time>2026</time></li>
          <li><span><em class="tag">General public</em><strong>Sovereignty &amp; entrepreneurship</strong></span><time>2026</time></li>
          <li><span><em class="tag">Outreach</em><strong>Inria science outreach team</strong></span><time>2024–25</time></li>
        </ul>
      </div>

      <div class="tile tile-mini-row tile-acad" data-reveal style="--delay: .26s">
        <p class="kicker">Education</p>
        <h3>Mathematics at Paris-Saclay</h3>
        <ul class="mini-list">
          <li><span><strong>MSc in Maths &amp; AI</strong> · with CentraleSupélec &amp; X · GPA&nbsp;4.0/4.0</span><time>2024</time></li>
          <li><span><strong>Double BSc in Maths &amp; Physics</strong> · GPA&nbsp;4.0 maths, 3.33&nbsp;physics</span><time>2022</time></li>
          <li><span><strong>Excellence scholarship</strong> · DataIA, twice</span><time>2023–24</time></li>
        </ul>
        <img class="tile-memoji corner" src="/img/memojie/study.png" alt="" width="420" height="420" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="wrap agenda-section">
    <div class="section-head" data-reveal>
      <p class="kicker">02 · What I work on</p>
      <h2 class="section-title">Three <em>threads</em></h2>
    </div>

    <div class="agenda">
      {(Object.keys(themes) as Theme[]).map((key, i) => {
        const related = papers.filter((p) => p.data.theme === key);
        return (
          <article class="theme" style={`--tone: ${tones[key]}; --delay: ${i * 0.08}s`} data-reveal>
            <p class="kicker">{themes[key].label}{themes[key].focus && <span class="focus">Main focus</span>}</p>
            <h3>{themes[key].question}</h3>
            <p class="theme-blurb">{themes[key].blurb}</p>
            {related.length > 0 && (
              <ul>
                {related.map((p) => (
                  <li>
                    <a href={p.data.link ?? "/publications"}>{p.data.short ?? p.data.title.split(":")[0]}</a>
                    <span>{p.data.venue}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="wrap bento-section">
    <div class="section-head" data-reveal>
      <p class="kicker">03 · Off the clock</p>
      <h2 class="section-title">Other things I <em>build</em></h2>
    </div>

    <div class="bento">
      <a class="tile tile-pub" href="/resume" data-reveal>
        <span class="glyph" aria-hidden="true">∂</span>
        <p class="kicker">Building</p>
        <h3>Doctoral entrepreneurship programme</h3>
        <p class="muted">Talks on AI &amp; cybersecurity and on sovereignty &amp; entrepreneurship (2026).</p>
      </a>

      <a class="tile tile-knowledge" href="/knowledge" data-reveal style="--delay: .12s">
        <p class="kicker">Mental palace</p>
        <p class="big-number">{notes.length}</p>
        <p>notes on statistics, ML &amp; optimisation, with proofs you can unfold.</p>
        <span class="tile-arrow"><Icon name="arrow" size={20} /></span>
      </a>
    </div>
  </section>

  <section class="wrap news-section">
    <div class="section-head" data-reveal>
      <p class="kicker">04 · Logbook</p>
      <h2 class="section-title">Latest <em>news</em></h2>
    </div>
    <NewsTimeline items={news} initial={6} />
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(2.5rem, 8vw, 6rem) clamp(4rem, 9vw, 7rem);
    isolation: isolate;
  }

  .blob {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.55;
    animation: drift 18s ease-in-out infinite alternate;
  }

  .blob-a {
    width: min(42rem, 80vw);
    aspect-ratio: 1;
    top: -12rem;
    right: -10rem;
    background: radial-gradient(circle, var(--accent), transparent 65%);
  }

  .blob-b {
    width: min(34rem, 70vw);
    aspect-ratio: 1;
    bottom: -10rem;
    left: -12rem;
    background: radial-gradient(circle, var(--cobalt), transparent 65%);
    opacity: 0.35;
    animation-duration: 24s;
  }

  @keyframes drift {
    to {
      transform: translate(-6%, 8%) scale(1.12);
    }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "kicker kicker"
      "title badge"
      "intro intro";
    align-items: center;
    column-gap: 2rem;
  }

  .hero-kicker {
    grid-area: kicker;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
  }

  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgb(34 197 94 / 0.6);
    animation: pulse 2.4s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgb(34 197 94 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(34 197 94 / 0);
    }
  }

  .hero-title {
    grid-area: title;
    font-size: clamp(4.2rem, 17vw, 13.5rem);
    font-weight: 380;
    line-height: 0.86;
    letter-spacing: -0.055em;
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
  }

  .hero-title .line {
    display: block;
  }

  .hero-title .indent {
    padding-left: 0.55em;
  }

  .hero-title em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
  }

  .sparkle {
    display: inline-block;
    margin-left: 0.08em;
    font-size: 0.35em;
    vertical-align: top;
    color: var(--cobalt);
    animation: spin 12s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .badge {
    grid-area: badge;
    position: relative;
    width: clamp(9rem, 22vw, 16rem);
    aspect-ratio: 1;
  }

  .badge img {
    position: absolute;
    inset: 18%;
    width: 64%;
    height: 64%;
    border-radius: 50%;
    background: var(--lime);
    transition: transform 0.6s var(--ease);
  }

  .badge:hover img {
    transform: rotate(-10deg) scale(1.08);
  }

  .ring {
    position: absolute;
    inset: 0;
    animation: spin 28s linear infinite;
  }

  .ring text {
    font-family: var(--font-mono);
    font-size: 12.2px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--ink);
  }

  .hero-intro {
    grid-area: intro;
    max-width: 40rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    margin-left: auto;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
  }

  .hero-intro p {
    margin: 0 0 1rem;
  }

  .hero-intro .serif-italic {
    font-size: 1.15em;
    color: var(--accent);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.3rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.3s var(--ease), background-color 0.2s, color 0.2s;
  }

  .btn:hover {
    color: var(--ink);
    transform: translateY(-2px);
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  @media (max-width: 640px) {
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "badge"
        "kicker"
        "title"
        "intro";
    }
    .badge {
      width: 8.5rem;
      margin-bottom: 1.5rem;
    }
    .hero-kicker {
      align-items: flex-start;
    }
    .dot {
      margin-top: 0.3rem;
      flex: none;
    }
  }

  /* ---- sections */

  .section-head {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .section-title {
    margin-top: 0.5rem;
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
  }

  .section-title em {
    font-style: italic;
    color: var(--accent);
  }

  .bento-section,
  .news-section {
    padding-top: clamp(4rem, 10vw, 8rem);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    min-height: 15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }

  .tile,
  .tile:hover {
    color: var(--fg, var(--ink));
  }

  .tile:hover {
    transform: translateY(-4px) rotate(-0.4deg);
    box-shadow: var(--shadow);
  }

  .tile p {
    margin: 0;
  }

  .tile h3 {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    letter-spacing: -0.03em;
  }

  .muted {
    color: var(--ink-2);
  }

  .tile-now {
    grid-column: span 4;
    padding-right: clamp(1.25rem, 22%, 14rem);
  }

  .tile-now .chips {
    margin-top: auto;
  }

  .tile-memoji {
    position: absolute;
    right: -1rem;
    bottom: -1.5rem;
    width: clamp(8rem, 18vw, 13rem);
    transition: transform 0.6s var(--ease);
  }

  .tile:hover .tile-memoji {
    transform: rotate(-8deg) translateY(-6px);
  }

  .tile-memoji.small {
    width: 8rem;
    right: -0.75rem;
    bottom: -1.25rem;
  }

  .tile-pub {
    grid-column: span 3;
    background: var(--accent);
    --fg: var(--accent-ink);
    border-color: transparent;
  }

  .tile-pub .kicker,
  .tile-pub .muted {
    color: color-mix(in srgb, var(--accent-ink) 75%, transparent);
  }

  .tile-pub h3 {
    font-size: 1.35rem;
    margin-top: auto;
    position: relative;
  }

  .glyph {
    position: absolute;
    top: -2.5rem;
    right: -0.5rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13rem;
    line-height: 1;
    opacity: 0.22;
    transition: transform 0.8s var(--ease);
  }

  .tile-pub:hover .glyph {
    transform: rotate(12deg) scale(1.1);
  }

  .tile-knowledge {
    grid-column: span 3;
    background: var(--cobalt);
    --fg: #fff;
    border-color: transparent;
  }

  .tile-knowledge .kicker {
    color: rgb(255 255 255 / 0.75);
  }

  .big-number {
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 6.5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
  }

  .tile-projects {
    grid-column: span 2;
    background: var(--lime);
    --fg: #17140f;
    border-color: transparent;
  }

  .tile-projects .kicker {
    color: rgb(23 20 15 / 0.7);
  }

  .tile-projects h3 {
    max-width: 14ch;
  }

  .tile-text {
    max-width: 22rem;
  }

  .tile-empirical .tile-memoji,
  .tile-theory .tile-memoji,
  .tile-mars .tile-memoji {
    width: clamp(7rem, 12vw, 9.5rem);
    right: -0.5rem;
    bottom: -1rem;
  }

  .tile-small {
    max-width: 16rem;
    font-size: 0.92rem;
  }

  .tile-empirical,
  .tile-theory {
    grid-column: span 3;
    min-height: 18rem;
    padding-right: clamp(1.25rem, 18%, 10rem);
  }

  .tile-empirical {
    background: var(--cobalt);
    --fg: #fff;
    border-color: transparent;
  }

  .tile-empirical .kicker {
    color: rgb(255 255 255 / 0.75);
  }

  .tile-theory {
    background: var(--ink);
    --fg: var(--paper);
    border-color: transparent;
  }

  .tile-theory .kicker {
    color: color-mix(in srgb, var(--paper) 65%, transparent);
  }

  .tile-empirical .big-number,
  .tile-theory .big-number {
    margin-top: 0.5rem;
  }

  .tile-mars {
    grid-column: span 6;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    min-height: 0;
    padding: clamp(1.25rem, 3vw, 1.5rem);
    padding-right: clamp(1.25rem, 12%, 8rem);
    background: var(--lime);
    --fg: #17140f;
    border-color: transparent;
  }

  .tile-mars .kicker {
    color: rgb(23 20 15 / 0.7);
  }

  .tile-mars .big-number {
    white-space: nowrap;
  }

  .tile-mars .big-number em {
    font-style: italic;
  }

  .mars-text p {
    max-width: 38rem;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    margin: 0;
  }

  .tile-hands {
    grid-column: span 2;
    background: var(--accent);
    --fg: var(--accent-ink);
    border-color: transparent;
  }

  .tile-hands .kicker,
  .tile-hands .stack {
