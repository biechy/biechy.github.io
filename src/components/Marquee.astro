---
interface Props {
  items: string[];
}
const { items } = Astro.props;
// The track holds the list twice so the loop can restart seamlessly at -50%.
const track = [...items, ...items];
---

<div class="marquee-clip">
  <div class="marquee" aria-label={items.join(", ")}>
    <div class="track" aria-hidden="true">
      {track.map((item) => (
        <span class="item">
          {item}
          <span class="star">✺</span>
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-clip {
    overflow-x: clip;
    padding-block: 1.5rem;
  }

  .marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding-block: 1rem;
    margin-inline: -2rem;
    background: var(--ink);
    color: var(--paper);
    transform: rotate(-2deg);
    box-shadow: var(--shadow);
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    font-style: italic;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }

  .star {
    font-style: normal;
    font-size: 0.6em;
    color: var(--lime);
  }

  .item:nth-child(3n + 2) .star {
    color: var(--accent);
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
